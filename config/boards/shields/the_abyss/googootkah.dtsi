#include <dt-bindings/zmk/matrix_transform.h>

// nice!view setup
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>,
                    <NRF_PSEL(SPIM_MISO, 10, 0)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>,
                    <NRF_PSEL(SPIM_MISO, 10, 0)>;
            low-power-enable;
        };
    };
};

nice_view_spi: &spi0 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
};


&pro_micro_i2c {
    status = "disabled";
};

// Key scan setup
/ {
    chosen {
        zmk,kscan = &default_kscan;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <24>;
        rows = <1>;
        map = <
                     RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)                      RC(0,17) RC(0,16) RC(0,15) RC(0,14)  
                     RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)                      RC(0,21) RC(0,20) RC(0,19) RC(0,18)
            RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)   RC(0,27) RC(0,26) RC(0,25) RC(0,24) RC(0,23) RC(0,22) 
        >;
    };

    // Composite kscan spaja izvor za buđenje i ostale tastere
    default_kscan: kscan {
        compatible = "zmk,kscan-composite";
        label = "KSCAN";
        rows = <1>;
        columns = <14>;

        // Tasteri pre G (W, E, R, T) -> kolone 0, 1, 2, 3
        keys_before_g {
            kscan = <&kscan_before_g>;
            column-offset = <0>;
        };

        // Jedini taster koji budi tastaturu (G: gpio0 9) -> kolona 4
        wakeup_key {
            kscan = <&kscan_wakeup>;
            column-offset = <4>;
        };

        // Tasteri posle G -> kolone 5 do 13
        keys_after_g {
            kscan = <&kscan_after_g>;
            column-offset = <5>;
        };
    };

    // Tasteri PRE G (ne bude tastaturu)
    kscan_before_g: kscan_before_g {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios =
            <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    // Poseban kscan SAMO za taster G (gpio0 9)
    kscan_wakeup: kscan_wakeup {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios =
            <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    // Tasteri POSLE G (ne bude tastaturu)
    kscan_after_g: kscan_after_g {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios =
            <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,

            <&gpio1 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
        ;
    };
};
