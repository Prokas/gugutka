#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "googootkah.h"

/*               KEY POSITIONS
 *
 *           ╭──────────────╮          ╭──────────────╮ 
 *           │ 0   1   2   3│          │17  16  15  14│
 *      ╭────╯ 4   5   6   7╰────╮╭────╯21  20  19  18╰────╮
 *      │  8   9  10  11  12  13 ││ 27  26  25  24  23  22 │
 *      ╰────────────────────────╯╰────────────────────────╯
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default {
            label = "DEF";
            bindings = <
/* Top (0-3 | 17-14) */             &kp W         &kp E         &kp R          &kp T                                                            &kp L         &hr LALT K    &hr RGUI J    &hr RSHFT N
/* Mid (4-7 | 21-18) */             &hl LALT S    &hl LGUI D    &hl LSHFT F    &hl RALT G                                                       &comsem        &dotcol       &hr RCTRL P   &hr RALT G
/* Low Left (8-13) & Right (27-22)*/ &hl LCTRL A   &kp C         &kp V          &kp B          &my_lt NUM X    &my_lt NAV SPACE   &hr RCTRL P    &dotcol       &comsem       &kp M         &my_lt FUN H  &my_lt SYM BSPC
            >;
        };

        numbers {
            label = "NUM";
            bindings = <
/* Top (0-3 | 17-14) */             &kp TAB       &kp LG(M)     &none          &kp LC(UP)                                                       &none         &kp N6        &kp N5        &kp N4
/* Mid (4-7 | 21-18) */             &hl LALT KP_MINUS &hl LGUI KP_ASTERISK &hl LSHFT KP_SLASH &kp RALT                                            &none         &kp N3        &kp N2        &kp N1
/* Low Left (8-13) & Right (27-22)*/ &hl LCTRL KP_PLUS &none       &none          &none          &trans          &trans             &none          &kp N3        &kp N2        &kp N1        &kp N0        &none
            >;
        };

        navigation {
            label = "NAV";
            bindings = <
/* Top (0-3 | 17-14) */             &none         &none         &kp DEL        &kp C_VOL_DN                                                     &none         &kp UP        &none         &none
/* Mid (4-7 | 21-18) */             &kp LA(LC(LG(UP_ARROW))) &sk LGUI &sk LSHFT &kp LG(C)                                                         &none         &kp LA(LC(LG(RIGHT))) &kp LA(LC(LG(LEFT))) &kp LG(LC(LA(M)))
/* Low Left (8-13) & Right (27-22)*/ &kp C_MUTE    &kp C_VOL_UP  &kp C_PLAY_PAUSE &kp LESS_THAN &kp GREATER_THAN &kp LG(V)          &kp RIGHT      &kp DOWN      &kp LEFT_ARROW &none        &kp MINUS     &kp PLUS
            >;
        };

        symbols {
            label = "SYM";
            bindings = <
/* Top (0-3 | 17-14) */             &kp LBRC      &kp RBRC      &kp LPAR       &kp RPAR                                                         &kp CARET     &kp EQUAL     &kp PIPE      &kp BACKSLASH
/* Mid (4-7 | 21-18) */             &kp AT        &kp HASH      &kp DOLLAR     &none                                                            &kp UNDERSCORE &kp DQT      &kp GRAVE     &kp EXCL
/* Low Left (8-13) & Right (27-22)*/ &none         &kp AMPERSAND &kp ASTERISK   &kp PERCENT    &trans          &trans             &trans         &trans        &trans        &kp TILDE     &none         &none
            >;
        };

        BT {
            label = "bt";
            bindings = <
/* Top (0-3 | 17-14) */             &none         &none         &none          &none                                                            &none         &none         &none         &none
/* Mid (4-7 | 21-18) */             &trans        &trans        &none          &none                                                            &none         &none         &trans        &trans
/* Low Left (8-13) & Right (27-22)*/ &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR_ALL &none          &none           &none              &none          &none         &none         &none         &trans        &kp LC(LG(Q))
            >;
        };

        LatinF {
            label = "FUN";
            bindings = <
/* Top (0-3 | 17-14) */             &kp SQT       &kp SEMICOLON &kp LEFT_BRACKET &kp RIGHT_BRACKET                                              &trans        &kp F6        &kp F5        &kp F4
/* Mid (4-7 | 21-18) */             &none         &none         &none          &kp BACKSLASH                                                    &none         &none         &none         &kp LC(LG(Q))
/* Low Left (8-13) & Right (27-22)*/ &kp F10       &kp F7        &kp F8         &kp F9         &kp F11         &kp F12            &trans         &kp F3        &kp F2        &kp F1        &none         &none
            >;
        };
    };
};
